#!/system/bin/sh

MODDIR=${0%/*}
STATE_DIR=/data/adb/omk
RESTART_FILE=$STATE_DIR/restart.keymint
PEER_RESTART_FILE=$STATE_DIR/restart.injector
RESTART_ALL_FILE=$STATE_DIR/restart.all

export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/vendor/lib64/:/system/lib64/:/apex/com.android.runtime/lib64/bionic/"

find_module_keymint() {
  if [ -f "/data/adb/omk/keymint" ]; then
    echo /data/adb/omk/keymint
    return 0
  fi
  if [ -f "$MODDIR/keymint" ]; then
    echo "$MODDIR/keymint"
    return 0
  fi
  if [ -f "$MODDIR/libs/arm64-v8a/keymint" ]; then
    echo "$MODDIR/libs/arm64-v8a/keymint"
    return 0
  fi
  if [ -f "$MODDIR/libs/x86_64/keymint" ]; then
    echo "$MODDIR/libs/x86_64/keymint"
    return 0
  fi
  return 1
}

expand_shared_restart() {
  if mv "$RESTART_ALL_FILE" "$RESTART_ALL_FILE.claimed.$$" 2>/dev/null; then
    : > "$RESTART_FILE"
    : > "$PEER_RESTART_FILE"
    rm -f "$RESTART_ALL_FILE.claimed.$$"
  fi
}

consume_restart_request() {
  expand_shared_restart

  if mv "$RESTART_FILE" "$RESTART_FILE.claimed.$$" 2>/dev/null; then
    rm -f "$RESTART_FILE.claimed.$$"
    return 0
  fi

  return 1
}

cd "$MODDIR" || exit 1
mkdir -p "$STATE_DIR"

echo $$ > "$STATE_DIR/keymint-daemon.pid"
trap 'rm -f "$STATE_DIR/keymint-daemon.pid"' EXIT INT TERM
retry_delay=2

while true; do
  TARGET=$(find_module_keymint)
  if [ -z "$TARGET" ]; then
    echo "[keymint-daemon] keymint binary not found"
    sleep 5
    continue
  fi

  chmod 0755 "$TARGET"

  "$TARGET" "$@" &
  child_pid=$!

  while kill -0 "$child_pid" 2>/dev/null; do
    if consume_restart_request; then
      echo "[keymint-daemon] restart requested"
      kill -TERM "$child_pid" 2>/dev/null
      sleep 2
      if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null
      fi
      break
    fi
    sleep 2
  done

  wait "$child_pid"
  rc=$?
  echo "[keymint-daemon] keymint exited with code $rc"
  if [ "$rc" -ne 0 ]; then
    if [ "$retry_delay" = "" ]; then retry_delay=2; else retry_delay=$((retry_delay * 2)); fi
    [ "$retry_delay" -gt 60 ] && retry_delay=60
  else
    retry_delay=2
  fi
  sleep "$retry_delay"
done
